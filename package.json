  "bin": {
    "curveguard": "./packages/cli/bin/curveguard.js"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://curveguard.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurveGuard-App/curveguard.git"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "apps/worker"
